# Postgres connection string (Supabase: Project settings > Database > Connection string, "Session pooler")
DATABASE_URL=postgres://user:password@host:5432/postgres
# Password for signing in to the app
APP_PASSWORD=change-me
# Only for the history backfill and Sheets sync scripts: path to a Google service account key with read-only access
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
